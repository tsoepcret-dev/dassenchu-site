---
import { name, primaryNav, infoNav } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  noindex?: boolean;
}
const { title, description, home, noindex } = Astro.props;
const pageTitle = home ? name + '｜大阪の深夜バーから、ひとこと英会話' : title + '｜' + name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/images/cover.jpg', Astro.site);
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:site_name" content={name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:image:alt" content="マークとミカが描かれた番組ジャケット" />
  <meta name="twitter:card" content="summary" />
</head>
<body>
  <a class="skip" href="#main">本文へ移動</a>
  <header class="site-header">
    <div class="shell header-inner">
      <a href="/" class="brand" aria-current={home ? 'page' : undefined}><span aria-hidden="true">◉</span> {name}</a>
      <nav aria-label="メインメニュー">
        {primaryNav.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main" class="shell"><slot /></main>
  <footer class="site-footer">
    <div class="shell footer-inner">
      <div><a class="brand" href="/">{name}</a><p>大阪の深夜バーから、ひとこと英会話。</p></div>
      <nav aria-label="サイト情報">
        {infoNav.map(({ href, label }) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </footer>
</body>
</html>
