---
import Base from '../layouts/Base.astro';
import EpisodeList from '../components/EpisodeList.astro';
import { episodes, spotify, youtube } from '../data/site';
---
<Base home title="トップ" description="閉店後の大阪の小さなバーで、マークとミカが脱線しながら英会話。番組と無料の復習教材を楽しめる公式サイトです。">
  <section class="hero">
    <div>
      <p class="eyebrow"><span class="light"></span> OSAKA AFTER HOURS / ENGLISH PODCAST</p>
      <h1>英会話、<br /><span>脱線中。</span></h1>
      <p class="lead">大阪の深夜バーから、ひとこと英会話。</p>
      <p>閉店後の小さなバーで、マークとミカが今日も脱線中。ふたりの話を聴いて、気になった英語をひとつだけ声に出してみよう。日本語の解説もあるで。</p>
      <div class="actions"><a class="button" href="/podcast/">エピソードを聴く <span aria-hidden="true">↗</span></a><a class="button outline" href="/learn/">フレーズをおさらい</a></div>
    </div>
    <figure class="sleeve">
      <img src="/images/cover.jpg" width="900" height="900" alt="レトロなセル画風に描かれたマークとミカの番組ジャケット" fetchpriority="high" />
      <figcaption><span>MARK &amp; MIKA</span><span>SIDE A / AFTER HOURS</span></figcaption>
    </figure>
  </section>
  <section class="block" aria-labelledby="episodes">
    <p class="eyebrow">01 / ON AIR</p>
    <h2 id="episodes">最近のエピソード</h2>
    <EpisodeList items={episodes.slice(0, 3)} />
    <div class="actions section-actions"><a class="button outline" href="/podcast/">エピソード一覧へ</a><a href={spotify}>Spotifyの番組ページ ↗</a><a href={youtube}>YouTubeの再生リスト ↗</a></div>
  </section>
  <section class="block" aria-labelledby="hosts">
    <p class="eyebrow">02 / AT THE COUNTER</p>
    <h2 id="hosts">マークとミカ</h2>
    <div class="grid">
      <article class="panel"><p class="eyebrow">MARK</p><h3>マーク</h3><p>ミカの「これ、英語でなんて言うん？」に、使えるひとことを返してくれる。</p></article>
      <article class="panel"><p class="eyebrow">MIKA</p><h3>ミカ</h3><p>身近な話から、気づけば英語の話に。「それ、言ってみたい！」とさっそく挑戦。</p></article>
    </div>
    <p class="muted">マークとミカは架空の人物です。番組ではAI音声を使っています。</p>
  </section>
</Base>
