---
import Base from '../layouts/Base.astro';
import EpisodeList from '../components/EpisodeList.astro';
import { episodes, spotify, youtube } from '../data/site';
---
<Base title="Podcast" description="『英会話、脱線中。』のエピソード一覧。SpotifyとYouTubeでマークとミカの英会話を楽しめます。">
  <header class="page-head">
    <p class="eyebrow">01 / ON AIR</p><h1>Podcast</h1>
    <p class="lead">閉店後のバーで繰り広げられる、英語と日本語の会話。</p>
    <div class="actions"><a class="button" href={spotify}>Spotifyで番組を聴く ↗</a><a class="button outline" href={youtube}>YouTubeで番組を見る ↗</a></div>
  </header>
  <section aria-labelledby="archive"><h2 id="archive">エピソード一覧</h2><EpisodeList items={episodes} /></section>
</Base>
